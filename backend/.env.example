# SecureVault Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real secrets.

# Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# Database (Supabase PostgreSQL connection)
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local Development Key (dev profile only)
# Generate with: openssl rand -base64 32
# This is NOT production-grade key management.
LOCAL_KEK=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# AWS KMS (prod profile only)
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/KEY_ID
# AWS credentials should come from IAM roles or the default credential chain.
